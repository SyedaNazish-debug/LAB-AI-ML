import numpy as np
import matplotlib.pyplot as plt
from minisom import MiniSom

data = np.array([
    [1.0, 1.2, 0.8],
    [1.2, 1.1, 0.9],
    [0.8, 1.0, 1.1],
    [5.0, 5.2, 4.8],
    [5.2, 4.9, 5.1],
    [4.8, 5.1, 5.0],
    [9.0, 8.8, 9.2],
    [8.9, 9.1, 9.0],
    [9.2, 9.0, 8.8]
])

# Normalize data
data = (data - data.min(axis=0)) / (
    data.max(axis=0) - data.min(axis=0)
)


som = MiniSom(
    x=5,
    y=5,
    input_len=3,
    sigma=1.0,
    learning_rate=0.5,
    random_seed=42
)

som.random_weights_init(data)

som.train_random(data, 100)


print("Best Matching Units:")
for i, sample in enumerate(data):
    bmu = som.winner(sample)
    print("Data", i + 1, "->", bmu)


plt.figure(figsize=(7, 7))

for i, sample in enumerate(data):
    x, y = som.winner(sample)
    plt.text(
        x + 0.5,
        y + 0.5,
        str(i + 1),
        color="black",
        ha="center",
        va="center"
    )

plt.title("Self-Organizing Map (SOM)")
plt.xlim(0, 5)
plt.ylim(0, 5)
plt.grid()
plt.show()

